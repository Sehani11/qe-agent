# Backend .env — copy to backend/.env for local runs (also read by training/serve).
# Unset keys use the defaults in app/core/config.py. Kaggle keys go in the root .env.

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
# openai (1536-dim index) | voyage (1024-dim index)
EMBEDDING_PROVIDER=openai
VOYAGE_API_KEY=

# --- BDD generation ---
# general_llm | fine_tuned
BDD_MODEL_PROVIDER=general_llm
FINE_TUNED_MODEL_ENDPOINT=http://localhost:9000/
FINE_TUNED_MODEL_API_KEY=

# --- Serving shim (training/serve) ---
FINE_TUNED_ADAPTER_DIR=

# --- Credential encryption (required to save per-project tokens) ---
# python -c "from app.core.crypto import generate_key; print(generate_key())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qe_agent
DIRECT_DATABASE_URL=

# --- Pinecone ---
PINECONE_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Integrations ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_USER_EMAIL=
GITHUB_ACCESS_TOKEN=
