# Repo-root .env — used by the backend, training tooling and cfn/ deploy scripts.
# Backend keys are synced to SSM on deploy; a missing/empty key is deleted from
# SSM and the backend uses its config.py default. No inline comments.

# --- LLM ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
# openai (1536-dim index) | voyage (1024-dim index); changing it needs a new index + re-ingest
EMBEDDING_PROVIDER=openai
VOYAGE_API_KEY=

# --- BDD generation ---
# general_llm | fine_tuned
BDD_MODEL_PROVIDER=general_llm
FINE_TUNED_MODEL_ENDPOINT=
FINE_TUNED_MODEL_API_KEY=

# --- Credential encryption (required to save per-project tokens) ---
# cd backend && python -c "from app.core.crypto import generate_key; print(generate_key())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Database ---
# Pooler URL (runtime); DIRECT_DATABASE_URL is for Alembic, falls back to DATABASE_URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qe_agent
DIRECT_DATABASE_URL=

# --- Pinecone ---
PINECONE_API_KEY=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Integrations (fallback when a project has no credentials of its own) ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_USER_EMAIL=
GITHUB_ACCESS_TOKEN=

# --- Fine-tuning on Kaggle ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Frontend build (cfn/deploy-frontend.sh) ---
# Supabase pair falls back to SUPABASE_URL / SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only list models whose vendor key is set
NEXT_PUBLIC_AVAILABLE_MODELS=openai:gpt-4o,openai:gpt-4o-mini,claude:claude-sonnet-5
NEXT_PUBLIC_DEFAULT_MODEL=openai:gpt-4o

# --- AWS CLI (managed by cfn/setup-infra.sh) ---
AWS_CLI_ACCESS_KEY_ID=
AWS_CLI_SECRET_ACCESS_KEY=
AWS_CLI_REGION=ap-south-1
AWS_CLI_OUTPUT=json
