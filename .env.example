# QE Verification Agent — Environment Variables
# Copy this file to .env and fill in values.
#
# This is the repo-root .env, shared by the backend and the training tooling.
# The backend ignores keys it does not recognise, so KAGGLE_* can live here
# alongside its own settings. For a backend-only deployment, backend/.env.sample
# is the narrower list.

# --- Dev stub (used only where real JWT auth is not in play) ---
DEV_USER_ID=dev-stub

# --- LLM provider (verification, RAG Q&A, BDD fallback) ---
# The DEFAULTS a call falls back to. A request carrying an explicit
# provider/model (the frontend model picker) overrides them per call; anything
# with no request behind it — the evaluation CLI, background jobs — lands here.
# Keep in step with the frontend's NEXT_PUBLIC_DEFAULT_MODEL.
LLM_PROVIDER=openai          # "claude", "openai", or "local" (Ollama)
LLM_MODEL=gpt-4o             # OpenAI model name; ignored by the other providers

# One key per vendor: the model picker means one deployment can talk to more
# than one of them in the same session, so each vendor gets its own variable.
# There is no shared key — a variable that names its vendor cannot be wrong
# about which vendor it is for.
#
# Set the key for whichever vendor EMBEDDING_PROVIDER names (below), even when
# LLM_PROVIDER is a different one: without it every knowledge-base and RAG
# surface returns no context.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which vendor embeds text for every RAG surface: "openai" or "voyage".
#
# Deliberately NOT tied to LLM_PROVIDER. An index is built with one embedding
# model, and a query must be compared against vectors from that same model or
# retrieval silently returns nothing. Selecting Claude for chat therefore does
# not — and must not — change how text is embedded.
#
# Changing this invalidates the existing index. Point PINECONE_INDEX_NAME at a
# NEW index created at the matching dimension and re-ingest:
#     openai (text-embedding-3-small) -> 1536
#     voyage (voyage-4)               -> 1024
# Pinecone rejects a vector of the wrong width, so a forgotten index shows up
# as a write failure rather than as quietly bad search results.
#
# Voyage: 200M tokens free, then $0.06/1M. Key from https://voyageai.com
EMBEDDING_PROVIDER=openai
VOYAGE_API_KEY=

# How many BDD scenarios one verification run sends at once.
#
# The run's rate-limit dial. Every in-flight scenario sends the repository
# evidence at the same moment, so this — not the evidence size — is what to
# turn down when a provider answers 429. The evidence caps exist to stop the
# agent reporting working code as missing, and are not the thing to trade away.
#
# 1 makes the run fully sequential. Raise it on a high-tier API key.
VERIFICATION_MAX_CONCURRENCY=2

# Ollama cannot call tools, so it cannot run agentic verification — the API
# refuses that combination up front rather than reporting a run that verified
# nothing.
OLLAMA_BASE_URL=http://ollama:11434   # Use http://localhost:11434 when the backend runs outside Docker
OLLAMA_MODEL=llama3.2:3b

# --- BDD model provider (fine-tuned model for BDD generation) ---
BDD_MODEL_PROVIDER=general_llm    # "general_llm" or "fine_tuned"
FINE_TUNED_MODEL_ENDPOINT=        # HTTP endpoint for fine-tuned model (Phase 2)
FINE_TUNED_MODEL_API_KEY=         # API key for fine-tuned model (Phase 2)
FINE_TUNED_MODEL_TIMEOUT_SECONDS=12    # Total bound; leaves room for the LLM fallback inside NFR-P3's 30s
# false = a fine-tuned failure is an error rather than silently general-LLM
# output served under the fine_tuned label. Use false for demos and measurement.
FINE_TUNED_ALLOW_FALLBACK=true
# false = keep saving BDD history, but exclude it from fine-tuning datasets.
# This is the ceiling: the per-request consent toggle is ANDed with it, so a
# user can narrow it but never widen it.
TRAINING_DATA_OPT_IN=true

# --- Credential encryption ---
# REQUIRED to store per-project Jira / Confluence / GitHub credentials. Without
# it the project settings page cannot save a token (500); the environment
# credentials below keep working regardless.
#
# Encryption, NOT hashing — these tokens are replayed to their APIs, so the
# plaintext must be recoverable. Generate one with:
#   cd backend && python -c "from app.core.crypto import generate_key; print(generate_key())"
#
# Back it up. Rotating it makes every stored credential unreadable, and the
# affected projects must have their tokens re-entered.
CREDENTIAL_ENCRYPTION_KEY=

# --- Database (Supabase PostgreSQL) ---
# Pooler URL — used by the app at runtime (Supabase Transaction mode, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qe_agent
# Direct URL — used by Alembic migrations only (Supabase Session mode or direct db.* host)
# Falls back to DATABASE_URL if left empty
DIRECT_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=qe-agent
# Minimum cosine similarity (0..1) for a knowledge chunk to count as relevant.
RAG_MIN_SCORE=0.3

# --- Integrations ---
# The DEPLOYMENT-WIDE fallback. A project that stores its own credentials uses
# those instead, all-or-nothing per integration — a project's base URL is never
# paired with the environment's token.

# Jira
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# Confluence (for project knowledge base ingestion)
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_USER_EMAIL=

# GitHub
GITHUB_ACCESS_TOKEN=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# One shared private bucket; per-feature data lives under subfolders
# (reports/, feature-files/, artifacts/).
SUPABASE_BUCKET=qe-agent

# --- Training (training/kaggle_run.py — see training/KAGGLE.md) ---
# Only needed to launch fine-tuning runs on Kaggle. The backend ignores these.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
DISABLE_DOCS=false
CORS_ALLOW_ORIGINS=http://localhost:3000
