# Environments
.env
.env.*
!.env.example
!.env.local.example

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo

.claude

aws-credentials.txt

# Python build artifacts (training/ sits outside backend/, so it needs this too)
__pycache__/
*.py[cod]

# Story 6.5 — derived training data and cloned corpora are never committed.
# train.jsonl can contain user-captured content, which Stories 6.6/6.7 exist to
# govern; and third-party .feature files carry their own licences.
training/data/
training/data-v1/
training/corpus/
# corpus-product/ IS committed: the ticket YAML is authored by hand and is the
# reviewable source of record. Only its generated .jsonl is derived.
training/corpus-product/*.jsonl
# Staging for the Kaggle push — holds a copy of train.jsonl.
training/.kaggle-staging/
# Trained adapters pulled back from Kaggle (161 MB safetensors).
training/outputs/

# The GGUF conversion toolchain, set up by hand next to the repo rather than
# vendored — see training/serve/README.md. Both are large (208 MB / 664 MB)
# and neither is ours: llama.cpp is a third-party clone carrying its own
# licence, and convert-venv pins numpy~=1.26.4 for the converter alone, which
# is exactly why it is not backend/.venv.
llama.cpp/
# uv writes a .gitignore inside a venv it creates, so this is belt and braces
# — but a venv built another way, or copied, would not carry one.
convert-venv/

dev-docs/